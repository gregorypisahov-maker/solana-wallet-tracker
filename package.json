{
  "name": "solana-wallet-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/cleanNextBuild.mjs && next build",
    "start": "next start",
    "single-bot": "node scripts/patch-market-bot-paper-default.mjs && node scripts/patch-single-market-bot-keyless.mjs && node scripts/patch-single-market-bot-store.mjs && node scripts/patch-single-market-bot-stablecoins.mjs && node scripts/patch-single-market-bot-telegram.mjs && tsx single-bot/marketBot.ts",
    "worker": "node scripts/retired-service.mjs worker",
    "paper-trader": "node scripts/retired-service.mjs paper-trader",
    "worker:dev": "node scripts/retired-service.mjs worker-dev",
    "telegram-bot": "node scripts/retired-service.mjs telegram-bot",
    "moonshot-scanner": "node scripts/retired-service.mjs moonshot-scanner",
    "live-executor": "node scripts/retired-service.mjs live-executor",
    "sol-spot-paper": "node scripts/retired-service.mjs sol-spot-paper",
    "onchain-rug:replay": "tsx scripts/replay-onchain-rug-gates.ts",
    "deployer:backfill": "tsx scripts/backfill-deployer-reputation.ts",
    "deployer:replay": "tsx scripts/replay-deployer-blacklist.ts",
    "helius-intelligence": "node scripts/retired-service.mjs helius-intelligence",
    "helius-flow-paper": "node scripts/retired-service.mjs helius-flow-paper",
    "test": "node --import tsx --test lib/*.test.ts worker/*.test.ts paper-trader/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jup-ag/api": "6.0.48",
    "@solana/web3.js": "^1.95.3",
    "@supabase/supabase-js": "^2.45.4",
    "bs58": "^6.0.0",
    "express": "5.2.1",
    "next": "14.2.35",
    "node-fetch": "^3.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.1",
    "typescript": "^5.5.3"
  }
}
