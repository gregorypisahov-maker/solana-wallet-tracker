# Optional worker tuning
POLL_INTERVAL_MINUTES=5
SCALP_WINDOW_MINUTES=5
ALERT_WINDOW_HOURS=24
MIN_SCORE_FOR_ALERT=8
WALLET_POLL_CONCURRENCY=4
