# ---- Solana RPC (Helius recommended — free tier works) ----
# Get one at https://dev.helius.xyz
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# ---- Supabase ----
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# service role key is used by the worker (server-side only, never expose to browser)

# ---- Token data ----
# DexScreener needs no key and is used by default.
# Optional: Birdeye gives holder counts + better liquidity data
BIRDEYE_API_KEY=

# ---- Telegram alerts ----
# Create a bot with @BotFather, then message it once and get your chat id from
# https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Monitor tuning ----
POLL_INTERVAL_MINUTES=2
SCALP_WINDOW_MINUTES=5
MIN_WALLETS_FOR_ALERT=3
ALERT_WINDOW_HOURS=24
