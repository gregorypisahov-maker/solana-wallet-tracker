# Server-side application and Railway worker variables
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=replace-me
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me
BIRDEYE_API_KEY=

# Generate with: openssl rand -hex 32
VIEWER_SHARE_TOKEN=replace-with-at-least-32-random-characters
DASHBOARD_ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional worker tuning. Auto mode creates one Free-plan enhanced webhook
# filtered to successful SWAPs; the standard WebSocket remains the fallback.
HELIUS_EVENT_MODE=auto
# Optional override. By default this is derived from NEXT_PUBLIC_SUPABASE_URL.
HELIUS_WEBHOOK_URL=https://YOUR_PROJECT.supabase.co/functions/v1/helius-webhook
RECONCILE_INTERVAL_SECONDS=900
CONSENSUS_REFRESH_INTERVAL_SECONDS=30
WALLET_REFRESH_INTERVAL_SECONDS=60
EVENT_DEDUPE_MINUTES=30
USAGE_FLUSH_INTERVAL_SECONDS=900
SCALP_WINDOW_MINUTES=5
ALERT_WINDOW_HOURS=24
MIN_SCORE_FOR_ALERT=8
WALLET_POLL_CONCURRENCY=1
MAX_SIGNATURES_PER_WALLET=500
RPC_MIN_INTERVAL_MS=200
MAX_TRADE_AGE_SECONDS=120
SIGNAL_MAX_AGE_MINUTES=10
MIN_TRACKED_TRADE_SOL=0.01
TELEGRAM_TIMEOUT_MS=10000
TOKEN_DATA_TIMEOUT_MS=12000
PRICE_FEED_TIMEOUT_MS=12000
